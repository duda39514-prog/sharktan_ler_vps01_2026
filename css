*{margin: 0;

    padding: 0;

    box-sizing: border-box;

}



body {
    background-image: url('fundo.png');
    background-color: rgb(234, 225, 211);
    font-family: 'Broadway', sans-serif;
    background-size: 100%;
    background-repeat: no-repeat ;
    
}


header {
    
    height: 110px;
    border-radius: 16px;
    margin: 20px;
    display: flex;
    background-color: rgb(46, 35, 35);
    text-align: center;
    padding: 20px 0;
}



header h1 {
    
    width: 63vw;
    height: 50px;
    display: flex;
    padding: 0 20px 0 18px;
    margin-bottom: 8px;
}

nav ul {
    list-style: none;
    padding: 10px 20px;     
    margin: 0;
    display: flex;          
    flex-direction: row;
    align-items: center;
    gap: 20px;              
   justify-content:space-between ;  
    width: max-content;     
}

nav ul li {
    display: inline;
    margin: 10px;
}

nav ul li a {
    color: rgb(233, 215, 185);
    text-decoration: none;
    transition: color 0.3s ease;
}

nav ul li a:visited {
    color: rgb(233, 215, 185);
}

nav ul li a:hover {
    color: rgb(39, 114, 179);
    cursor: pointer;
}

.opcoes {
    background-color: rgb(179, 20, 20);
    gap: 5px;
    margin: 8px;
    border-radius: 8px;
}

.imagem {       
    padding: 0px 5px;
    margin: 50px;
    bottom: 10px;         
    right: 10px;         
    width: 550px;       
    height: auto;         
}

.arrumar {
  display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-left: 100px;
    margin-top: -50px;
    line-height: 0.7;
    letter-spacing: -2px;
}

.container {
    display: flex;
    align-items: center;
    gap: 20px;
}

.bonitinho {
    background-color: rgb(234, 225, 211);;
     line-height: 0.7;
    letter-spacing: 0px;
       display: inline-block;
    border: 2px solid #c50c0c;
    border-radius: 30px;
    padding: 10px 20px;
    font-size: 12px;
    color: #333;
}

.quadrado {
    position: absolute;
    width: 200px;
    height: 160px;
    border: 2px solid #8e590b;
    border-radius: 40px;
    pointer-events: none;
}


.quadrado1 {
      display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color:#b95922 ;
    top: 250px;
     width: 200px;  
    height: 80px; 
    border: 2px solid #d8cbb8;
    border-radius: 40px;
    left: 30px;
    z-index: 1;
}

.quadrado2 {
      display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color:#b84c0e ;
    top: 500px;
    width: 200px;  
    height: 80px; 
    left: 455px;
    z-index: 1;
}

.bonitinho2 {
     line-height: 0;
    letter-spacing: 0px;
}

.bonitinho3{
      background-color: rgb(161, 56, 56);;
     line-height: 0.7;
     width: 100px;
     height: 50px;
    letter-spacing: 0px;
       display: inline-block;
    border: 2px solid #c50c0c;
    border-radius: 30px;
    padding: 10px 20px;
    font-size: 12px;
    color: #333;
}

.perfil{
    width: 40px;
    border-radius: 10px;
}

section{
    display: flex;
    margin: 80px;
  margin-top: -5px; 
    padding: 40px;   
    background-color: #b84c0e;
    border-radius: 25px;
}
